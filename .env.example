# Server-only Google Gemini API key. Never expose this as NEXT_PUBLIC_*.
GEMINI_API_KEY=your-gemini-api-key

# Browser-visible Supabase project URL and publishable key. Enable strict RLS
# on every table; never use a Supabase service-role/secret key in these fields.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Email confirmation links should return to this origin. Set this to your
# deployed HTTPS origin in the production environment.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
